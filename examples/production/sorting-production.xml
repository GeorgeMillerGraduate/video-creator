    <code id="code" x="920" y="335" width="830" height="480" size="25" title="BubbleSort.java" lineNumbers="true">for (int pass = 0; pass &lt; n - 1; pass++) {
  for (int j = 0; j &lt; n - pass - 1; j++) {
    if (a[j] &gt; a[j + 1]) {
