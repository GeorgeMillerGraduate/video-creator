  <code id="code" x="175" y="450" size="23" language="java"><![CDATA[
for (int end = numbers.length - 1; end > 0; end--) {
    for (int j = 0; j < end; j++) {
        if (numbers[j] > numbers[j + 1]) {
            swap(numbers, j, j + 1);
        }
    }
}
