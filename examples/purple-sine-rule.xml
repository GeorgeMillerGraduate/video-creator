    <step id="third" number="1" title="Find the third angle" x="900" y="260" width="620" height="150" padding="24">
      <equation id="thirdEq" x="26" y="81" value="C = 180° − 72° − 58° = 50°" size="32" font="Serif" color="#EDF6FF" typeset="false" />
    </step>
    <step id="rule" number="2" title="Match sides with opposite angles" x="900" y="430" width="620" height="190" padding="24">
      <equation id="ruleEq" x="30" y="116" value="\frac{a}{sin 72°} = \frac{8}{sin 50°}" size="40" font="Serif" color="#EDF6FF" typeset="true" />
