    <triangle id="triangle" points="394.36125,262.93691 140.00000,670.00000 735.92773,670.00000" vertices="A,B,C" sides="c = 8,a = ?,b" sideMask="2" angleMask="4" />
    <panel id="formula" x="80" y="735" width="700" height="82">
      <equation id="sineRule" x="25" y="29" value="a / sin A = b / sin B = c / sin C" size="29" font="Serif" color="#DCC6FF" typeset="false" />
