<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="JengaVideoStudio.App.Views.HomeView" Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1320" HorizontalAlignment="Left">
      <WrapPanel>
        <StackPanel Width="600" Margin="0,0,16,16">
          <Border Style="{StaticResource Card}" Background="{StaticResource HeroBrush}" Padding="28" ClipToBounds="True">
            <Grid>
              <Viewbox Width="170" Height="190" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.2" IsHitTestVisible="False" Margin="0,40,0,0">
                <Canvas Width="170" Height="180">
                  <Path Data="M 15,15 L 150,90 L 15,165 Z" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" />
                  <Path Data="M 40,45 L 122,90 L 40,135 Z" Fill="{StaticResource SecondaryAccentBrush}" />
                  <Path Data="M 70,72 L 103,90 L 70,108 Z" Fill="{StaticResource AccentBrush}" />
                </Canvas>
              </Viewbox>
              <StackPanel>
                <TextBlock Text="YOUR PERSONAL VIDEO STUDIO" Style="{StaticResource Eyebrow}" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="Turn ideas into&#10;amazing videos" FontSize="36" FontWeight="SemiBold" LineHeight="43" Margin="0,12,0,16" />
                <TextBlock Text="AI research. Scripts, visuals and narration.&#10;One place to bring your story together." Style="{StaticResource Muted}" FontSize="14" Margin="0,0,0,24" />
                <Button Content="＋  CREATE NEW VIDEO  →" Command="{Binding Navigate}" CommandParameter="Create" Style="{StaticResource Primary}" HorizontalAlignment="Left" />
              </StackPanel>
            </Grid>
          </Border>
          <UniformGrid Columns="5" Margin="0,16,0,24">
            <StackPanel Margin="8,6">
              <Path Data="{StaticResource ResearchIcon}" Stroke="{StaticResource AccentHoverBrush}" StrokeThickness="1.4" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,10" />
              <TextBlock Text="Research" FontWeight="SemiBold" />
              <TextBlock Text="With real sources" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Margin="8,6">
              <Path Data="{StaticResource GenerateIcon}" Stroke="{StaticResource AccentHoverBrush}" StrokeThickness="1.4" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,10" />
              <TextBlock Text="Generate" FontWeight="SemiBold" />
              <TextBlock Text="Scripts and scenes" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Margin="8,6">
              <Path Data="{StaticResource NarrationIcon}" Stroke="{StaticResource AccentHoverBrush}" StrokeThickness="1.4" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,10" />
              <TextBlock Text="Narration" FontWeight="SemiBold" />
              <TextBlock Text="Voice and captions" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Margin="8,6">
              <Path Data="{StaticResource RenderIcon}" Stroke="{StaticResource AccentHoverBrush}" StrokeThickness="1.4" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,10" />
              <TextBlock Text="Render" FontWeight="SemiBold" />
              <TextBlock Text="Portrait video" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Margin="8,6">
              <Path Data="{StaticResource UploadIcon}" Stroke="{StaticResource AccentHoverBrush}" StrokeThickness="1.4" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,10" />
              <TextBlock Text="Upload" FontWeight="SemiBold" />
              <TextBlock Text="YouTube, optionally" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />
            </StackPanel>
          </UniformGrid>
          <Border Style="{StaticResource Card}" Visibility="{Binding HasProject,Converter={StaticResource Visible}}" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="CONTINUE WHERE YOU LEFT OFF" Style="{StaticResource Eyebrow}" />
              <TextBlock Text="{Binding CurrentTitle,Mode=OneWay}" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,8" />
              <TextBlock Text="{Binding CurrentSummary,Mode=OneWay}" Style="{StaticResource Muted}" />
              <TextBlock Text="{Binding SaveStatus,Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,12" />
              <WrapPanel>
                <Button Content="Open workspace →" Command="{Binding Navigate}" CommandParameter="Review" />
                <Button Content="Project files" Command="{Binding OpenFolder}" Style="{StaticResource QuietButton}" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Width="340" Margin="0,0,0,16">
          <Border Style="{StaticResource Card}" Padding="16">
            <StackPanel>
              <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="View all →" Command="{Binding Navigate}" CommandParameter="Projects" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Padding="4" />
                <TextBlock Text="Recent projects" FontSize="19" FontWeight="SemiBold" />
              </DockPanel>
              <TextBlock Text="No projects yet. Create your first video and it will appear here." Margin="0,20">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasProjects}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="380">
                <ItemsControl ItemsSource="{Binding ProjectCards}" ItemTemplate="{StaticResource ProjectCardTemplate}" />
              </ScrollViewer>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Padding="16" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="QUICK ACTIONS" Style="{StaticResource Eyebrow}" />
              <Button Content="＋  Create new video" Command="{Binding Navigate}" CommandParameter="Create" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" />
              <Button Content="Open a project →" Command="{Binding Navigate}" CommandParameter="Projects" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" />
              <Button Content="Manage components →" Command="{Binding Navigate}" CommandParameter="Settings" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </StackPanel>
      </WrapPanel>
      <TextBlock Text="Getting started" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,16" />
      <WrapPanel>
        <Border Style="{StaticResource Card}" Width="300" Margin="0,0,16,16">
          <StackPanel>
            <TextBlock Text="01  Prepare your studio" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="Check your models, video engine and voice before creating your first video." Style="{StaticResource Muted}" Margin="0,12,0,16" />
            <Button Content="Get set up →" Command="{Binding Navigate}" CommandParameter="Settings" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Width="300" Margin="0,0,16,16">
          <StackPanel>
            <TextBlock Text="02  Start with an idea" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="Choose a topic, duration and tone. Review each scene before sharing." Style="{StaticResource Muted}" Margin="0,12,0,16" />
            <Button Content="Create a video →" Command="{Binding Navigate}" CommandParameter="Create" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Width="300" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="03  Make it your own" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="Learn how to refine scenes, render your video and optionally upload it." Style="{StaticResource Muted}" Margin="0,12,0,16" />
            <Button Content="Read the guide →" Command="{Binding Navigate}" CommandParameter="Help" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>