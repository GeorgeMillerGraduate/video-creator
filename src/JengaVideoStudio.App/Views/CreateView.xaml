<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" x:Class="JengaVideoStudio.App.Views.CreateView">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid IsEnabled="{Binding Idle}" MaxWidth="820" HorizontalAlignment="Center" Margin="12,20">
      <StackPanel>
        <TextBlock Text="LET'S MAKE SOMETHING" Style="{StaticResource Eyebrow}" Foreground="{StaticResource AccentHoverBrush}" />
        <TextBlock Text="What should the video be about?" FontSize="32" FontWeight="SemiBold" Margin="0,8,0,12" />
        <TextBlock Text="Ask a question, explore a topic, or try one of the suggested ideas." Style="{StaticResource Muted}" FontSize="14" Margin="0,0,0,24" />
        <TextBox Text="{Binding Idea,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Video idea" AcceptsReturn="True" TextWrapping="Wrap" Height="98" FontSize="20" VerticalScrollBarVisibility="Auto" Padding="16" />
        <WrapPanel Margin="0,12,0,20">
          <Button Content="✦ Suggest ideas" Command="{Binding Suggest}" Style="{StaticResource QuietButton}" />
          <Button Content="Surprise me" Command="{Binding Surprise}" Style="{StaticResource QuietButton}" />
        </WrapPanel>
        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,18" Visibility="{Binding HasSuggestions,Converter={StaticResource Visible}}">
          <StackPanel>
            <ListBox ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedSuggestion}" MaxHeight="180" />
            <Button Content="Use selected idea →" Command="{Binding UseIdea}" HorizontalAlignment="Left" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,14,0">
            <TextBlock Text="Duration (seconds)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding TargetSeconds,ValidatesOnExceptions=True}" AutomationProperties.Name="Target duration in seconds" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,14,0">
            <TextBlock Text="Tone" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding Tones}" SelectedItem="{Binding Tone}" AutomationProperties.Name="Narration tone" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Visual quality" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding Quality}" AutomationProperties.Name="Visual quality" />
          </StackPanel>
        </Grid>
        <TextBlock Text="Light uses graphic scenes. Balanced can use your configured visual generators." Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,8" />
        <Expander Header="Preferred research sources · optional">
          <StackPanel Margin="0,12">
            <TextBlock Text="Public article URLs, one per line. Add authoritative sources for a more focused research pack." Style="{StaticResource Muted}" Margin="0,0,0,8" />
            <TextBox Text="{Binding SuppliedUrls}" AutomationProperties.Name="Preferred source URLs" Height="94" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
          </StackPanel>
        </Expander>
        <Button Content="CREATE VIDEO   →" Command="{Binding Make}" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,28,0,12" MinWidth="235" />
        <TextBlock Text="Your project is saved as production progresses. You always review before uploading." Style="{StaticResource Muted}" FontSize="11" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>