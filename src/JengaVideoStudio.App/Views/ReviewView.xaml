<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" x:Class="JengaVideoStudio.App.Views.ReviewView">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12">
      <WrapPanel DockPanel.Dock="Right">
        <Button Content="Render final video" Command="{Binding Resume}" Style="{StaticResource Primary}" />
        <Button Content="Export →" Command="{Binding Navigate}" CommandParameter="Export" />
      </WrapPanel>
      <StackPanel>
        <TextBlock Text="{Binding CurrentTitle, Mode=OneWay}" FontSize="19" FontWeight="SemiBold" MaxHeight="48" />
        <TextBlock Text="{Binding SaveStatus, Mode=OneWay}" Foreground="{StaticResource AccentHoverBrush}" FontSize="11" Margin="0,4,0,0" />
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="235" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="310" />
      </Grid.ColumnDefinitions>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="155" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource PreviewBackgroundBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6">
          <Grid>
            <TextBlock Text="Your video preview will appear here after rendering." Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" TextAlignment="Center" />
            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform" MediaOpened="MediaOpened" MediaFailed="MediaFailed" MediaEnded="MediaEnded" />
          </Grid>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource SurfaceRaisedBrush}" Padding="8" Margin="0,4,0,8" CornerRadius="5">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="▶" Click="Play" AutomationProperties.Name="Play preview" Padding="9,5" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Content="Ⅱ" Click="Pause" AutomationProperties.Name="Pause preview" Padding="9,5" />
              <Button Content="■" Click="Stop" AutomationProperties.Name="Stop preview" Padding="9,5" />
            </StackPanel>
            <Slider x:Name="Seek" Grid.Column="2" Minimum="0" Maximum="1" ValueChanged="SeekChanged" VerticalAlignment="Center" Margin="5,0,12,0" AutomationProperties.Name="Playback position" />
            <TextBlock x:Name="PlaybackTime" Grid.Column="3" Text="0:00 / 0:00" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <StackPanel Grid.Row="2">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Full video" Command="{Binding PreviewFinal}" Style="{StaticResource QuietButton}" Padding="5,2" />
            <TextBlock Text="{Binding PreviewNote, Mode=OneWay}" Style="{StaticResource Muted}" FontSize="10" MaxHeight="28" />
          </DockPanel>
          <ListBox ItemsSource="{Binding SceneCards}" SelectedItem="{Binding SelectedSceneCard}" Style="{StaticResource SceneStrip}" Margin="0,8,0,5" />
        </StackPanel>
        <Expander Grid.Row="3" Header="Timing overview · measured scene durations" Margin="0,5,0,0">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxHeight="110">
            <StackPanel Margin="0,8">
              <TextBlock Text="Narration and visuals · 12 pixels per second · untimed scenes omitted" Style="{StaticResource Muted}" FontSize="10" />
              <ItemsControl ItemsSource="{Binding SceneCards}" Margin="0,8">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="{Binding TimelineWidth}" Visibility="{Binding HasDuration,Converter={StaticResource Visible}}" Height="42" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" ToolTip="{Binding Range}">
                      <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="6" VerticalAlignment="Center" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Expander>
      </Grid>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="15">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel IsEnabled="{Binding Idle}">
            <DockPanel>
              <TextBlock Text="Scene details" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SelectedSceneDuration, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
            </DockPanel>
            <TextBlock Text="{Binding SelectedSceneLabel, Mode=OneWay}" Foreground="{StaticResource AccentHoverBrush}" FontSize="11" Margin="0,6,0,7" />
            <TextBlock Text="Narration / voiceover" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding SceneNarration,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Selected scene narration" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" MaxHeight="210" VerticalScrollBarVisibility="Auto" />
            <TextBlock Text="On-screen heading" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding SceneHeading,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Selected scene heading" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="54" />
            <TextBlock Text="Visual treatment" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding VisualTypes}" SelectedItem="{Binding SceneVisualType}" AutomationProperties.Name="Selected scene visual treatment" />
            <TextBlock Text="Image / video prompt" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding SceneVisualPrompt,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Selected scene visual prompt" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto" />
            <TextBlock Text="Graphic labels · one per line" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding ScenePoints,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Selected scene graphic labels" AcceptsReturn="True" TextWrapping="Wrap" Height="78" VerticalScrollBarVisibility="Auto" />
            <TextBlock Text="SCENE ACTIONS" Style="{StaticResource Eyebrow}" Margin="0,20,0,8" />
            <Button Content="✓ Apply changes" Command="{Binding SaveEdits}" Style="{StaticResource Primary}" Margin="0,0,0,8" />
            <Button Content="Regenerate visual" Command="{Binding Regenerate}" Margin="0,0,0,8" />
            <Button Content="▶ Preview this scene" Command="{Binding PreviewScene}" Margin="0,0,0,8" />
            <TextBlock Text="Regeneration uses the existing production pipeline. Saved changes appear in the video after rendering." Style="{StaticResource Muted}" FontSize="10" />
            <Expander Header="Sources and quality notes">
              <StackPanel>
                <TextBox Text="{Binding SourceText,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="200" VerticalScrollBarVisibility="Auto" Margin="0,10,0,10" />
                <TextBlock Text="{Binding WarningText, Mode=OneWay}" Foreground="{StaticResource WarningBrush}" FontSize="11" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>