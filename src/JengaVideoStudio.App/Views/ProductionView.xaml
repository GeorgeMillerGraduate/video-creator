<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JengaVideoStudio.App.Views.ProductionView"
             Background="{StaticResource AppBackgroundBrush}"
             Foreground="{StaticResource TextPrimaryBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <!-- MAIN PRODUCTION WORKSPACE -->
        <ScrollViewer Grid.Column="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- OVERALL PROGRESS -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right"
                          Margin="18,0,0,0"
                          VerticalAlignment="Top">
                                <TextBlock Text="{Binding ProgressLabel,Mode=OneWay}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding Elapsed,Mode=OneWay}"
                           Style="{StaticResource Muted}"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           Margin="0,3,0,0" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="PRODUCTION"
                           Style="{StaticResource Eyebrow}" />
                                <TextBlock Text="{Binding StageTitle,Mode=OneWay}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Margin="0,4,0,0" />
                                <TextBlock Text="{Binding CurrentTitle,Mode=OneWay}"
                           FontSize="16"
                           Margin="0,8,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="{Binding Detail,Mode=OneWay}"
                       Style="{StaticResource Muted}"
                       TextWrapping="Wrap"
                       MinHeight="34"
                       Margin="0,14,0,10" />

                        <ProgressBar Value="{Binding Progress}"
                         IsIndeterminate="{Binding Indeterminate}"
                         Height="12" />

                        <ItemsControl ItemsSource="{Binding PipelineSteps}"
                          ItemTemplate="{StaticResource PipelineTemplate}"
                          Margin="0,20,0,18">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"
                               Rows="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <WrapPanel>
                            <Button Content="Cancel safely"
                      Command="{Binding Cancel}"
                      Style="{StaticResource CancelButton}" />

                            <Button Content="Resume production"
                      Command="{Binding Resume}" />

                            <Button Content="Review video →"
                      Command="{Binding Navigate}"
                      CommandParameter="Review" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- SCENES -->
                <DockPanel Margin="0,20,0,8">
                    <TextBlock DockPanel.Dock="Right"
                     Text="{Binding CurrentSummary,Mode=OneWay}"
                     Style="{StaticResource Muted}"
                     FontSize="11"
                     VerticalAlignment="Center" />

                    <TextBlock Text="SCENES"
                     Style="{StaticResource Eyebrow}" />
                </DockPanel>

                <ListBox ItemsSource="{Binding SceneCards}"
                 SelectedItem="{Binding SelectedSceneCard}"
                 Style="{StaticResource SceneStrip}" />

                <TextBlock Text="Scene cards appear as soon as the scene plan is available."
                   Style="{StaticResource Muted}"
                   FontSize="11"
                   Margin="0,8,0,0" />

                <!-- SAVED EVENT LOG -->
                <Expander Header="Saved production events"
                  Margin="0,16,0,0">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="These are the saved milestone events. The detailed live journal is shown below the production workspace."
                       Style="{StaticResource Muted}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />

                        <ListBox ItemsSource="{Binding Events}"
                     MaxHeight="150" />

                        <Button Content="Open detailed log"
                    Command="{Binding ViewLog}"
                    Style="{StaticResource QuietButton}"
                    HorizontalAlignment="Left"
                    Margin="0,8,0,0" />
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT SIDEBAR -->
        <ScrollViewer Grid.Column="2"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- CURRENT SCENE -->
                <Border Style="{StaticResource Card}"
                Padding="14">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="CURRENT SCENE"
                         Style="{StaticResource Eyebrow}" />

                            <TextBlock DockPanel.Dock="Right"
                         Text="{Binding SelectedSceneDuration,Mode=OneWay}"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         FontSize="11" />
                        </DockPanel>

                        <TextBlock Text="{Binding SelectedSceneLabel,Mode=OneWay}"
                       FontWeight="SemiBold"
                       Margin="0,7,0,12" />

                        <Grid Height="250">
                            <Border Background="{StaticResource SurfaceRaisedBrush}"
                      CornerRadius="5">
                                <StackPanel Margin="18"
                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SceneHeading,Mode=OneWay}"
                             FontSize="20"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap" />

                                    <TextBlock Text="{Binding SelectedSceneCard.PreviewLabel,Mode=OneWay}"
                             Style="{StaticResource Muted}"
                             TextWrapping="Wrap"
                             Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>

                            <Image Source="{Binding SelectedSceneCard.Thumbnail}"
                     Stretch="Uniform" />
                        </Grid>

                        <TextBlock Text="NARRATION"
                       Style="{StaticResource Eyebrow}"
                       Margin="0,14,0,5" />

                        <TextBlock Text="{Binding SceneNarration,Mode=OneWay}"
                       Style="{StaticResource Muted}"
                       TextWrapping="Wrap"
                       MaxHeight="110" />
                    </StackPanel>
                </Border>

                <!-- LIVE ACTIVITY SUMMARY -->
                <Border Style="{StaticResource Card}"
                Padding="14"
                Margin="0,14,0,0">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="LIVE ACTIVITY"
                         Style="{StaticResource Eyebrow}" />

                            <TextBlock DockPanel.Dock="Right"
                         Text="{Binding ProgressLabel,Mode=OneWay}"
                         Foreground="{StaticResource AccentHoverBrush}"
                         FontWeight="SemiBold"
                         FontSize="11" />
                        </DockPanel>

                        <TextBlock Text="{Binding LiveActivityTitle,Mode=OneWay}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,7,0,0"
                       TextWrapping="Wrap" />

                        <TextBlock Text="{Binding LiveActivity,Mode=OneWay}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontFamily="Consolas"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       MaxHeight="170" />

                        <ProgressBar Value="{Binding Progress}"
                         IsIndeterminate="{Binding Indeterminate}"
                         Height="6"
                         Margin="0,12,0,0" />

                        <TextBlock Text="Model inference has no reliable percentage while a response is being generated. Live token and timing information is shown instead when available."
                       Style="{StaticResource Muted}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- PIPELINE EXPLANATION -->
                <Border Style="{StaticResource Card}"
                Padding="14"
                Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="WHAT IS HAPPENING?"
                       Style="{StaticResource Eyebrow}" />

                        <TextBlock Text="{Binding StageTitle,Mode=OneWay}"
                       Foreground="{StaticResource AccentHoverBrush}"
                       FontWeight="SemiBold"
                       Margin="0,6,0,0" />

                        <TextBlock Text="{Binding Detail,Mode=OneWay}"
                       Style="{StaticResource Muted}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
