<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" x:Class="JengaVideoStudio.App.Views.SettingsView">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel IsEnabled="{Binding Idle}">
      <TextBlock Text="Prepare your studio" Style="{StaticResource Title}" />
      <TextBlock Text="Check the essentials once. Add optional creative tools whenever you're ready." Style="{StaticResource Muted}" FontSize="14" Margin="0,0,0,20" />
      <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceRaisedBrush}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="INSTALL / REPAIR" Command="{Binding RepairComponents}" Style="{StaticResource Primary}" VerticalAlignment="Center" Margin="20,0,0,0" />
          <StackPanel>
            <TextBlock Text="One place for your components" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Checks this PC and guides you through missing essentials. Downloads require your approval." Style="{StaticResource Muted}" Margin="0,8,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
      <ItemsControl ItemsSource="{Binding Components}" Margin="0,16,0,6">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Width="300" MinHeight="142" Padding="16" Margin="0,0,16,16">
              <StackPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Symbol, Mode=OneWay}" FontSize="20" Style="{StaticResource ComponentStatus}" />
                  <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" />
                </DockPanel>
                <TextBlock Text="{Binding Status, Mode=OneWay}" Style="{StaticResource ComponentStatus}" FontSize="12" Margin="0,8,0,8" />
                <TextBlock Text="{Binding Detail, Mode=OneWay}" Style="{StaticResource Muted}" FontSize="11" MinHeight="32" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <WrapPanel>
        <Button Content="Check components" Command="{Binding Check}" />
        <Button Content="Test narration" Command="{Binding TestNarration}" />
        <Button Content="Connect YouTube" Command="{Binding Connect}" />
      </WrapPanel>
      <TextBlock Text="Optional generators can remain unconfigured: the studio can use narration and graphic scenes. Your Google client configuration is only needed for uploading." Style="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0" />
      <Expander Header="Advanced setup · models, paths, workflows and account configuration" IsExpanded="{Binding AdvancedSetup}" Margin="0,24,0,0">
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <StackPanel.Resources>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Margin" Value="0,4,8,4" />
              </Style>
              <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Margin" Value="0,4,0,8" />
              </Style>
              <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="Margin" Value="0,4,0,8" />
              </Style>
            </StackPanel.Resources>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="28" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="1  LOCAL AI" Foreground="{StaticResource AccentHoverBrush}" FontWeight="Bold" />
                <TextBlock Text="Install and launch Ollama, then download a text model here. 7B is recommended for source-grounded writing." Margin="0,10,0,8" />
                <Button Content="Open official Ollama download" Command="{Binding OpenLink}" CommandParameter="https://ollama.com/download/windows" />
                <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding Settings.Model}" IsEditable="True" Text="{Binding Settings.Model}" />
                <CheckBox Content="Force CPU inference (slower, avoids GPU memory pressure)" IsChecked="{Binding Settings.CpuOnly}" />
                <Button Content="Download text model" Command="{Binding PullModel}" />
                <Button Content="Test local AI" Command="{Binding TestModel}" />
                <TextBlock Text="2  VIDEO ENCODER" Foreground="{StaticResource AccentHoverBrush}" FontWeight="Bold" Margin="0,25,0,10" />
                <Button Content="Download and configure FFmpeg" Command="{Binding InstallFfmpeg}" />
                <TextBlock Text="3  NARRATION" Foreground="{StaticResource AccentHoverBrush}" FontWeight="Bold" Margin="0,25,0,10" />
                <ComboBox ItemsSource="{Binding SpeechProviders}" SelectedItem="{Binding Settings.SpeechProvider}" />
                <TextBlock Text="Windows speech needs no AI download. For a neural voice, install Python 3.11/3.12 x64, then use the Piper button." Foreground="{StaticResource TextSecondaryBrush}" />
                <WrapPanel>
                  <Button Content="Get Python" Command="{Binding OpenLink}" CommandParameter="https://www.python.org/downloads/windows/" />
                  <Button Content="Install neural voice" Command="{Binding InstallPiper}" />
                  <Button Content="Test narration" Command="{Binding TestNarration}" />
                </WrapPanel>
                <TextBlock Text="4  PROJECT FOLDER" Foreground="{StaticResource AccentHoverBrush}" FontWeight="Bold" Margin="0,25,0,10" />
                <TextBox Text="{Binding Settings.ProjectRoot}" />
                <Button Content="Choose folder" Command="{Binding Browse}" CommandParameter="projects" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="COMPONENT CHECK" Foreground="{StaticResource AccentHoverBrush}" FontWeight="Bold" />
                <Button Content="Check components and hardware" Command="{Binding Check}" />
                <TextBox Text="{Binding Diagnostics,Mode=OneWay}" IsReadOnly="True" Height="370" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                <TextBlock Text="5  YOUTUBE (OPTIONAL)" Foreground="{StaticResource AccentHoverBrush}" FontWeight="Bold" Margin="0,15,0,10" />
                <TextBlock Text="Create a Google Desktop OAuth client using the guide. Sign-in happens in Google's browser page. The app never asks for your password." Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="OAUTH CLIENT JSON" Margin="0,15,0,0" />
                <TextBox Text="{Binding Settings.GoogleClientJson}" />
                <Button Content="Choose Google client JSON" Command="{Binding Browse}" CommandParameter="oauth" />
                <TextBlock Text="YOUR CHANNEL URL" />
                <TextBox Text="{Binding Settings.YouTubeChannelUrl}" />
                <WrapPanel>
                  <Button Content="Connect / Re-authorize" Command="{Binding Connect}" />
                  <Button Content="Disconnect" Command="{Binding Disconnect}" />
                  <Button Content="Open channel" Command="{Binding OpenChannel}" />
                </WrapPanel>
                <TextBlock Text="{Binding YouTubeStatus, Mode=OneWay}" Foreground="{StaticResource AccentHoverBrush}" />
                <TextBlock Text="DEFAULT UPLOAD PRIVACY" Margin="0,12,0,0" />
                <ComboBox ItemsSource="{Binding PrivacyOptions}" SelectedItem="{Binding Settings.DefaultPrivacy}" />
              </StackPanel>
            </Grid>
            <Expander Header="Optional local image and video generation">
              <StackPanel Margin="12">
                <TextBlock Text="Install ComfyUI and the models required by your workflow. Choose an API-format workflow with {{PROMPT}} in its positive prompt. See workflows/README.md. Light mode ignores these; choose Balanced to use them." Foreground="{StaticResource TextSecondaryBrush}" />
                <Button Content="Open ComfyUI installation guide" Command="{Binding OpenLink}" CommandParameter="https://docs.comfy.org/installation/desktop/windows" />
                <TextBox Text="{Binding Settings.ComfyEndpoint}" />
                <CheckBox Content="Enable generated images" IsChecked="{Binding Settings.EnableImages}" />
                <TextBox Text="{Binding Settings.ImageWorkflow}" />
                <Button Content="Choose image workflow JSON" Command="{Binding Browse}" CommandParameter="image" />
                <CheckBox Content="Enable generated video (high GPU memory requirement)" IsChecked="{Binding Settings.EnableVideo}" />
                <TextBox Text="{Binding Settings.VideoWorkflow}" />
                <Button Content="Choose video workflow JSON" Command="{Binding Browse}" CommandParameter="video" />
              </StackPanel>
            </Expander>
            <Expander Header="Advanced component paths">
              <StackPanel Margin="12">
                <TextBlock Text="OLLAMA ENDPOINT" />
                <TextBox Text="{Binding Settings.OllamaEndpoint}" />
                <TextBlock Text="FFMPEG EXECUTABLE" />
                <TextBox Text="{Binding Settings.Ffmpeg}" />
                <Button Content="Locate ffmpeg.exe" Command="{Binding Browse}" CommandParameter="ffmpeg" />
                <TextBlock Text="FFPROBE EXECUTABLE" />
                <TextBox Text="{Binding Settings.Ffprobe}" />
                <Button Content="Locate ffprobe.exe" Command="{Binding Browse}" CommandParameter="ffprobe" />
                <TextBlock Text="PYTHON EXECUTABLE (FOR PIPER SETUP)" />
                <TextBox Text="{Binding Settings.Python}" />
                <Button Content="Locate python.exe" Command="{Binding Browse}" CommandParameter="python" />
                <TextBlock Text="PIPER ENVIRONMENT PYTHON" />
                <TextBox Text="{Binding Settings.PiperPython}" />
                <TextBlock Text="PIPER VOICE ONNX" />
                <TextBox Text="{Binding Settings.PiperVoice}" />
                <Button Content="Locate voice" Command="{Binding Browse}" CommandParameter="voice" />
                <TextBlock Text="WINDOWS VOICE NAME (EMPTY USES DEFAULT)" />
                <TextBox Text="{Binding Settings.WindowsVoice}" />
              </StackPanel>
            </Expander>
            <Button Content="SAVE SETTINGS" Command="{Binding SaveSettings}" Style="{StaticResource Primary}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>