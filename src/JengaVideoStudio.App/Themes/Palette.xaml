  <Geometry x:Key="CreateIcon">M 12,3 L 12,21 M 3,12 L 21,12</Geometry>
  <Geometry x:Key="ProjectsIcon">M 2,6 L 9,6 L 12,9 L 22,9 L 22,21 L 2,21 Z</Geometry>
  <Geometry x:Key="HelpIcon">M 2,4 L 10,4 L 12,6 L 14,4 L 22,4 L 22,21 L 14,21 L 12,23 L 10,21 L 2,21 Z M 12,6 L 12,23</Geometry>
  <Geometry x:Key="ResearchIcon">M 4,2 L 15,2 L 20,7 L 20,20 L 4,20 Z M 8,7 L 13,7 M 8,11 L 16,11 M 8,15 L 14,15</Geometry>
  <Geometry x:Key="GenerateIcon">M 4,20 L 18,6 M 15,3 L 21,9 M 5,2 L 5,8 M 2,5 L 8,5 M 19,15 L 19,21 M 16,18 L 22,18</Geometry>
  <Geometry x:Key="NarrationIcon">M 9,3 L 15,3 L 15,14 L 9,14 Z M 5,10 L 5,15 L 8,18 L 16,18 L 19,15 L 19,10 M 12,18 L 12,22 M 8,22 L 16,22</Geometry>
