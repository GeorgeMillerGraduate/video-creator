<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#081E2D" />
  <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#061521" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#0D2639" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#12334A" />
  <SolidColorBrush x:Key="CardBrush" Color="#12334A" />
  <SolidColorBrush x:Key="BorderBrush" Color="#24506A" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F7FA" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A8BED0" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="#ADC2D1" />
  <SolidColorBrush x:Key="AccentBrush" Color="#22D3C5" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#64E8DC" />
  <SolidColorBrush x:Key="SecondaryAccentBrush" Color="#63BDF0" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#53D8AB" />
  <SolidColorBrush x:Key="WarningBrush" Color="#F5BE66" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#FF9292" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="#062C32" />
  <SolidColorBrush x:Key="PreviewBackgroundBrush" Color="#06121D" />
  <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#3B2030" />
  <SolidColorBrush x:Key="DangerBorderBrush" Color="#A05C70" />
  <SolidColorBrush x:Key="HoverBorderBrush" Color="#6194B3" />
  <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#12334A" Offset="0" />
    <GradientStop Color="#174C60" Offset="0.62" />
    <GradientStop Color="#0D2639" Offset="1" />
  </LinearGradientBrush>
  <Thickness x:Key="SpaceSmall">8</Thickness>
  <Thickness x:Key="SpaceMedium">16</Thickness>
  <Thickness x:Key="SpaceLarge">24</Thickness>
  <SolidColorBrush x:Key="CanvasBrush" Color="{Binding Color, Source={StaticResource AppBackgroundBrush}, Mode=OneWay}" />
  <SolidColorBrush x:Key="PanelBrush" Color="{Binding Color, Source={StaticResource SurfaceBrush}, Mode=OneWay}" />
  <SolidColorBrush x:Key="RaisedBrush" Color="{Binding Color, Source={StaticResource SurfaceRaisedBrush}, Mode=OneWay}" />
  <SolidColorBrush x:Key="LineBrush" Color="{Binding Color, Source={StaticResource BorderBrush}, Mode=OneWay}" />
  <SolidColorBrush x:Key="TextBrush" Color="{Binding Color, Source={StaticResource TextPrimaryBrush}, Mode=OneWay}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{Binding Color, Source={StaticResource TextSecondaryBrush}, Mode=OneWay}" />
