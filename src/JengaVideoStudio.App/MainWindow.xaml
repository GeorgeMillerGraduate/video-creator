<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ns2="clr-namespace:JengaVideoStudio.App.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="JengaVideoStudio.App.MainWindow" Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI" FontSize="13" Title="Jenga Video Studio — Personal Test 0.2" Width="1440" Height="920" MinWidth="960" MinHeight="620" WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="?  Help" Command="{Binding Navigate}" CommandParameter="Help" Style="{StaticResource QuietButton}" />
                    <Button Content="Settings" Command="{Binding Navigate}" CommandParameter="Settings" Style="{StaticResource QuietButton}" />
                    <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="12" Padding="10,4" Margin="8,0,0,0">
                        <TextBlock Text="PERSONAL  0.2" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="36" Height="42" Margin="0,0,16,0">
                        <Canvas Width="36" Height="42">
                            <Path Data="M 2,2 L 13,8 L 13,34 L 2,40 Z" Fill="{StaticResource SecondaryAccentBrush}" />
                            <Path Data="M 13,8 L 35,21 L 24,27 L 13,20 Z" Fill="{StaticResource AccentHoverBrush}" />
                            <Path Data="M 13,34 L 24,27 L 13,20 L 13,8 L 35,21 L 13,34 Z" Fill="{StaticResource SecondaryAccentBrush}" Opacity="0.75" />
                        </Canvas>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="22" FontWeight="Bold">
              <Run Text="JENGA " />
              <Run Text="VIDEO" Foreground="{StaticResource AccentHoverBrush}" />
              <Run Text=" STUDIO" Foreground="{StaticResource SecondaryAccentBrush}" />
                        </TextBlock>
                        <TextBlock Text="An idea. A researched story. Your next video." Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="178" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="10,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <RadioButton Style="{StaticResource Nav}" GroupName="Navigation" IsChecked="{Binding IsHome,Mode=OneWay}" Command="{Binding Navigate}" CommandParameter="Home">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource HomeIcon}" Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Margin="0,0,12,0" />
                                <TextBlock Text="Home" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Nav}" GroupName="Navigation" IsChecked="{Binding IsCreate,Mode=OneWay}" Command="{Binding Navigate}" CommandParameter="Create">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource CreateIcon}" Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Margin="0,0,12,0" />
                                <TextBlock Text="Create" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Nav}" GroupName="Navigation" IsChecked="{Binding IsProjects,Mode=OneWay}" Command="{Binding Navigate}" CommandParameter="Projects">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ProjectsIcon}" Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Margin="0,0,12,0" />
                                <TextBlock Text="Projects" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Nav}" GroupName="Navigation" IsChecked="{Binding IsHelp,Mode=OneWay}" Command="{Binding Navigate}" CommandParameter="Help">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource HelpIcon}" Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Margin="0,0,12,0" />
                                <TextBlock Text="Getting started" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <Border Style="{StaticResource Card}" Padding="12" Margin="0,20,0,0" Visibility="{Binding HasProject,Converter={StaticResource Visible}}">
                            <StackPanel>
                                <TextBlock Text="CURRENT PROJECT" Style="{StaticResource Eyebrow}" />
                                <TextBlock Text="{Binding CurrentTitle, Mode=OneWay}" FontWeight="SemiBold" MaxHeight="60" />
                                <TextBlock Text="{Binding CurrentSummary, Mode=OneWay}" Style="{StaticResource Muted}" FontSize="10" Margin="0,8,0,8" />
                                <Button Content="Open workspace →" Command="{Binding Navigate}" CommandParameter="Review" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="0,5" />
                                <Button Content="Project files" Command="{Binding OpenFolder}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="0,5" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="12" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="SYSTEM STATUS" Style="{StaticResource Eyebrow}" />
                                <TextBlock Text="{Binding DiskSpace, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,8" />
                                <ItemsControl ItemsSource="{Binding Components}" ItemTemplate="{StaticResource ComponentCompact}" />
                                <Button Content="Manage components" Command="{Binding Navigate}" CommandParameter="Settings" FontSize="10" Margin="0,12,0,0" Padding="8,9" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Grid Grid.Column="1" Margin="20,16,20,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="6" Margin="0,0,0,14" Visibility="{Binding IsProjectWorkspace,Converter={StaticResource Visible}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <RadioButton Style="{StaticResource Workflow}" GroupName="Workflow" IsChecked="{Binding IsCreate,Mode=OneWay}" Command="{Binding Navigate}" CommandParameter="Create">
                            <StackPanel>
                                <TextBlock Text="01  Create" FontWeight="SemiBold" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Your idea" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="19,3,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" Style="{StaticResource Workflow}" GroupName="Workflow" IsChecked="{Binding IsProduction,Mode=OneWay}" Command="{Binding Navigate}" CommandParameter="Production">
                            <StackPanel>
                                <TextBlock Text="02  Production" FontWeight="SemiBold" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="AI at work" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="19,3,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="2" Style="{StaticResource Workflow}" GroupName="Workflow" IsChecked="{Binding IsReview,Mode=OneWay}" Command="{Binding Navigate}" CommandParameter="Review">
                            <StackPanel>
                                <TextBlock Text="03  Review" FontWeight="SemiBold" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Edit and refine" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="19,3,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="3" Style="{StaticResource Workflow}" GroupName="Workflow" IsChecked="{Binding IsExport,Mode=OneWay}" Command="{Binding Navigate}" CommandParameter="Export">
                            <StackPanel>
                                <TextBlock Text="04  Export" FontWeight="SemiBold" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Your finished video" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="19,3,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </Border>
                <TabControl Grid.Row="1" SelectedIndex="{Binding PageIndex}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" Background="Transparent">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <ContentPresenter Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                        </ControlTemplate>
                    </TabControl.Template>
                    <TabItem>
                        <ns2:HomeView />
                    </TabItem>
                    <TabItem>
                        <ns2:CreateView />
                    </TabItem>
                    <TabItem>
                        <ns2:ProjectsView />
                    </TabItem>
                    <TabItem>
                        <ns2:ProductionView />
                    </TabItem>
                    <TabItem>
                        <ns2:ReviewView />
                    </TabItem>
                    <TabItem>
                        <ns2:ExportView />
                    </TabItem>
                    <TabItem>
                        <ns2:SettingsView />
                    </TabItem>
                    <TabItem>
                        <ns2:HelpView />
                    </TabItem>
                </TabControl>

                <!-- Detailed production telemetry. Visible only on the Production page. -->
                <Grid Grid.Row="2"
              Margin="0,12,0,0"
              Height="230"
              Visibility="{Binding IsProduction,Converter={StaticResource Visible}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Chronological production journal -->
                    <Border Grid.Column="0"
                  Style="{StaticResource Card}"
                  Padding="14"
                  Margin="0,0,7,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding Elapsed,Mode=OneWay}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="PRODUCTION JOURNAL"
                             Style="{StaticResource Eyebrow}" />
                                    <TextBlock Text="Detailed activity from research, local AI, narration and rendering"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             FontSize="11"
                             Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <Grid Grid.Row="1">
                                <TextBlock Text="{Binding ProductionJournalEmptyText,Mode=OneWay}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasProductionJournal}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ListBox ItemsSource="{Binding ProductionJournal}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Visibility="{Binding HasProductionJournal,Converter={StaticResource Visible}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 TextWrapping="Wrap"
                                 Margin="0,2,8,4" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Current live operation -->
                    <Border Grid.Column="1"
                  Style="{StaticResource Card}"
                  Padding="14"
                  Margin="7,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="LIVE ACTIVITY"
                           Style="{StaticResource Eyebrow}" />
                                <TextBlock Text="{Binding LiveActivityTitle,Mode=OneWay}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,5,0,0" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1"
                            Margin="0,12,0,10"
                            VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding LiveActivity,Mode=OneWay}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontFamily="Consolas"
                           FontSize="11"
                           TextWrapping="Wrap" />
                            </ScrollViewer>

                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ProgressBar Height="6"
                             Value="{Binding Progress}"
                             IsIndeterminate="{Binding Indeterminate}"
                             Visibility="{Binding Busy,Converter={StaticResource Visible}}" />
                                <DockPanel Grid.Row="1" Margin="0,7,0,0">
                                    <TextBlock DockPanel.Dock="Right"
                             Text="{Binding ProgressLabel,Mode=OneWay}"
                             Foreground="{StaticResource AccentHoverBrush}"
                             FontWeight="SemiBold"
                             FontSize="11" />
                                    <TextBlock Text="{Binding StageTitle,Mode=OneWay}"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             FontSize="11"
                             TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,7">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding Cancel}" Style="{StaticResource CancelButton}" Padding="12,4" Visibility="{Binding Busy,Converter={StaticResource Visible}}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding SaveStatus, Mode=OneWay}" Foreground="{StaticResource AccentHoverBrush}" FontSize="11" VerticalAlignment="Center" Margin="14,0" />
                <ProgressBar DockPanel.Dock="Right" Width="85" Value="{Binding Progress}" IsIndeterminate="{Binding Indeterminate}" Margin="12,0" Visibility="{Binding Busy,Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding Detail, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" MaxHeight="30" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>